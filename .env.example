# ─────────────────────────────────────────────────────────────
# LLM 엔드포인트 (OpenAI 호환 규격)
# 사내 gemma가 vLLM / Ollama / TGI 중 무엇으로 서빙되든
# BASE_URL 과 MODEL 만 맞추면 동일 코드로 동작합니다.
#
#   vLLM   : http://<host>:8000/v1
#   Ollama : http://<host>:11434/v1
#   TGI    : http://<host>:8080/v1
#   (테스트용 OpenAI: https://api.openai.com/v1)
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 인증이 없는 사내 엔드포인트라면 LLM_API_KEY 에 아무 문자열(예: dummy)을 넣으세요.
# OpenAI 클라이언트가 빈 키를 거부합니다.
#
# 폴백 규칙 (core/llm.py):
#   LLM_API_KEY  가 비어 있으면  OPENAI_API_KEY 를 사용
#   LLM_BASE_URL 이 비어 있으면  https://api.openai.com/v1
#   LLM_MODEL    이 비어 있으면  gpt-4o-mini
# → 지금처럼 OPENAI_API_KEY 만 채워두면 OpenAI로 먼저 검증하고,
#   사내 gemma로 옮길 때 위 세 줄만 채우면 코드 변경 없이 전환됩니다.
# 같은 대상 repo를 두 모델로 각각 돌려 통과율을 비교하면
#   "프롬프트 문제 vs 모델 성능 문제" 를 분리할 수 있습니다. (PLAN.md 8절 3단계)

# ── 생성 파라미터 ────────────────────────────────────────────
LLM_TEMPERATURE=0.2          # 1차 시도 (안정성 우선)
LLM_TEMPERATURE_RETRY=0.8    # best-of-N 추가 후보 (다양성 확보)
LLM_TEMPERATURE_REPAIR=0.3   # 실패 수리
LLM_MAX_TOKENS=1536          # 테스트 2~4개 분량
LLM_TIMEOUT_S=120
LLM_MAX_CONTEXT_TOKENS=4096  # 프롬프트 상한. 소형 모델은 길수록 정확도가 떨어짐

# ── 파이프라인 정책 ──────────────────────────────────────────
TARGET_COVERAGE=80.0
GENERATION_MODE=characterize # characterize | strict
                             #   characterize: 하네스가 실행 결과로 assert 생성 (성공률 높음,
                             #                 현재 동작을 정답으로 고정하므로 검토 필요)
                             #   strict      : LLM이 기대값까지 작성 (약한 모델에서 성공률 낮음)
CANDIDATES_PER_TARGET=3      # best-of-N. 약한 모델일수록 올릴 것 (3~5)
MAX_REPAIR_ATTEMPTS=2        # 초과 시 폐기하고 다음 타깃으로. 3 이상은 대부분 낭비
STALL_THRESHOLD=20           # 연속 N타깃 수락 0건이면 정체로 판단하고 중단
FULL_RECHECK_EVERY=10        # N배치마다 전체 커버리지 재측정 (드리프트 보정)

# ── 예산 ─────────────────────────────────────────────────────
MAX_LLM_CALLS=500
MAX_RUNTIME_MINUTES=120

# ── 테스트 실행 샌드박스 ─────────────────────────────────────
PYTEST_TIMEOUT_S=30          # 개별 테스트 타임아웃 (무한루프 차단)
BLOCK_NETWORK=true           # conftest 주입으로 소켓 차단
FAIL_ON_INTEGRITY_VIOLATION=true
                             # 테스트 외 파일이 변경되면 즉시 전체 중단 (기본 권장)

# ── 대상 저장소 ──────────────────────────────────────────────
REPO_URL=                    # git URL 또는 로컬 경로
REPO_BRANCH=
SOURCE_PACKAGE=              # 커버리지 측정 대상. 예: src  또는  mypkg
PYTHON_BIN=python            # venv 생성에 쓸 인터프리터
